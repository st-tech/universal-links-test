{
	"compilerOptions": {
		"strict": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"verbatimModuleSyntax": true,
		"isolatedDeclarations": true,
		"types": ["node"]
	},
	"exclude": ["dist", "tests", "demo", "src/**/*.spec.ts"]
}
